{
  "name": "nataltruth-final",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "NatalTruth — precision natal + multi-tradition name-number calculation, rebuilt around trust, readability, and shareable value.",
  "scripts": {
    "build": "tsc --noEmit false --outDir dist",
    "dev:api": "pnpm build && node dist/server/src/index.js",
    "start": "NODE_ENV=production node dist/server/src/index.js",
    "start:api": "NODE_ENV=production node dist/server/src/index.js",
    "check": "tsc --noEmit",
    "verify": "node scripts/verify-truth-layer.mjs",
    "verify:full": "pnpm build && pnpm verify"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "swisseph-wasm": "^0.0.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^24.7.0",
    "tsx": "^4.19.1",
    "typescript": "5.9.3"
  }
}
